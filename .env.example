# Copy to .env locally. Keep the actual webhook out of Git.
FEISHU_WEBHOOK_URL=
# Open chat ID for the single collection group, e.g. oc_...
FEISHU_CHAT_ID=
# Optional absolute path when the background service has a restricted PATH.
LARK_CLI_PATH=
# bot-events uses a Feishu application bot; user-poll uses an existing authorized CLI user session.
FEISHU_RECEIVE_MODE=bot-events
